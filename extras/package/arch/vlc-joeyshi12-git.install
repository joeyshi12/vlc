# The plugin cache records each plugin's size and modification time, so it
# is generated on the installed files. Without it VLC loads every plugin at
# startup and reports a stale cache.

post_install() {
  /opt/vlc/libexec/vlc/vlc-cache-gen /opt/vlc/lib/vlc/plugins
}

post_upgrade() {
  post_install
}

pre_remove() {
  rm -f /opt/vlc/lib/vlc/plugins/plugins.dat
}
